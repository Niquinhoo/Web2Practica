{
  "dependencies": {
    "@cloudflare/workers-types": "5.20261029.1",
    "cf": "1.0.0-beta.25",
    "typescript": "7.0.2"
  },
  "name": "web2-practica-tp3-deploy",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "cf deploy --dry-run",
    "predeploy": "node -e \"if(require('node:child_process').execFileSync('git',['branch','--show-current'],{encoding:'utf8'}).trim()!=='TP3')throw new Error('El deploy requiere la rama TP3')\"",
    "deploy": "cf deploy --secrets-file .secrets/production.json",
    "predeploy:db-proxy": "npm run predeploy",
    "deploy:db-proxy": "cd database-proxy && cf deploy --secrets-file ../.secrets/database-proxy.json",
    "test": "node --test src/*.test.mjs"
  },
  "engines": {
    "node": ">=24.22.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.7",
    "vite": "8.3.5"
  }
}
